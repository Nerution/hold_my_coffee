{
  "name": "good-things-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Good Things: positive, sourced news. Web app and Capacitor shell for Android and iOS.",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "assets": "npx capacitor-assets generate --android --ios --iconBackgroundColor '#1F3D2F' --iconBackgroundColorDark '#10201A' --splashBackgroundColor '#1F3D2F' --splashBackgroundColorDark '#10201A'"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "esbuild": "^0.28.2"
  }
}
